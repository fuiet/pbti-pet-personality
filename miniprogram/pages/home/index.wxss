.home-page {
  background: #f6efe4;
  padding-bottom: 170rpx;
}

.hero-card {
  padding: 20rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, #fff7ef 0%, #fff4e8 100%);
  border: 1rpx solid rgba(242, 204, 171, 0.55);
}

.hero-image {
  width: 100%;
  height: 220rpx;
  border-radius: 24rpx;
  background: #fff8f2;
}

.hero-kicker {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #ff6a1a;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.08;
  font-weight: 800;
  color: #2f251d;
  letter-spacing: -0.6rpx;
}

.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #8a7768;
}

.hero-button {
  margin-top: 14rpx;
  width: 100%;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7a22 0%, #ff6a1a 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 24rpx;
}

.hero-metrics {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(242, 204, 171, 0.7);
  display: flex;
  justify-content: space-between;
}

.metric {
  width: 33.333%;
  text-align: center;
}

.metric-value {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #ff7a22;
  line-height: 1.05;
}

.metric-label {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a7768;
}

.feature-strip {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.feature-card {
  flex: 1;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid rgba(242, 204, 171, 0.58);
  padding: 16rpx 14rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.feature-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: #2f251d;
}

.feature-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #9a7b65;
}

.ad-card {
  margin-top: 16rpx;
  border-radius: 24rpx;
  padding: 18rpx 20rpx 14rpx;
  border: 1rpx dashed rgba(242, 204, 171, 0.95);
  background: rgba(255, 250, 244, 0.95);
  text-align: center;
}

.ad-note {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #b49a88;
}

.types-section {
  margin-top: 24rpx;
}

.section-head {
  margin-bottom: 14rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #2f251d;
}

.section-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a7b65;
}

.types-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.type-card {
  width: calc(33.333% - 10rpx);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(242, 204, 171, 0.58);
  padding: 12rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.type-image-shell {
  height: 132rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fff8f2 0%, #fff2e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.type-image {
  width: 100%;
  height: 100%;
}

.type-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-index {
  font-size: 20rpx;
  font-weight: 800;
  color: #ff7a22;
}

.type-code {
  font-size: 18rpx;
  font-weight: 700;
  color: #a48b7d;
  letter-spacing: 1rpx;
}

.type-name {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #40332b;
  line-height: 1.18;
}
