.result-card {
  position: relative;
  overflow: hidden;
}

.result-primary {
  width: 100%;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7a22 0%, #ff6a1a 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 24rpx;
}

.result-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.result-stat {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.6);
}

.result-stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #ff6a1a;
  line-height: 1;
}

.result-stat-text {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8f735f;
}

.share-card {
  padding: 18rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #fff7ee 0%, #ffe8d1 100%);
  border: 1rpx solid rgba(242, 204, 171, 0.9);
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
}

.share-card-inner {
  min-height: 400rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 166, 94, 0.18), transparent 28%),
    linear-gradient(180deg, #fffefc 0%, #fff5ea 100%);
  border: 1rpx solid rgba(255, 196, 140, 0.35);
  padding: 26rpx;
  box-sizing: border-box;
}

.share-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.share-hero {
  width: 150rpx;
  height: 58rpx;
}

.share-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #ff6a1a;
  letter-spacing: 2rpx;
}

.share-visual {
  margin-top: 18rpx;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fff9f3 0%, #fff2e4 100%);
  border: 1rpx solid rgba(255, 196, 140, 0.32);
}

.share-badge {
  width: fit-content;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1e5;
  border: 1rpx solid #ffb57a;
}

.share-code {
  font-size: 22rpx;
  font-weight: 800;
  color: #ff6a1a;
}

.share-title {
  display: block;
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #2f251d;
}

.share-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7d695b;
}

.share-divider {
  margin-top: 22rpx;
  height: 1rpx;
  background: rgba(255, 176, 107, 0.45);
}

.share-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.share-brand {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #2f251d;
  letter-spacing: 1rpx;
}

.share-note {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b08f75;
}

.share-mini {
  min-width: 120rpx;
  padding: 14rpx 16rpx;
  border-radius: 22rpx;
  background: #fff8f2;
  border: 1rpx solid #efd9c7;
  text-align: center;
}

.share-mini-value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #ff6a1a;
  line-height: 1;
}

.share-mini-text {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8f735f;
}
