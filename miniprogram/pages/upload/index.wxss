.upload-page {
  padding-bottom: 170rpx;
}

.upload-intro {
  align-items: center;
  text-align: center;
}

.species-illustration-shell {
  width: 100%;
  height: 200rpx;
  padding: 12rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fff8f2 0%, #fff1e5 100%);
  box-sizing: border-box;
}

.species-illustration {
  width: 100%;
  height: 100%;
}

.progress-shell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  width: 100%;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f2e4d8;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff8a2a 0%, #ff6a1a 100%);
}

.progress-text {
  font-size: 22rpx;
  color: #9a7b65;
  white-space: nowrap;
}

.species-row {
  display: flex;
  gap: 12rpx;
}

.species-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  background: #fff8f2;
  border: 1rpx solid #efd9c7;
  color: #907865;
  font-size: 26rpx;
}

.species-chip.active {
  background: #fff1e5;
  border-color: #ffb57a;
  color: #ff6a1a;
  font-weight: 700;
}

.upload-card {
  padding: 22rpx;
}

.upload-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-state {
  font-size: 22rpx;
  color: #b08f75;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff8f2;
  border: 1rpx solid #efd9c7;
}

.photo-state.done {
  color: #ff6a1a;
  background: #fff1e5;
  border-color: #ffb57a;
}

.upload-preview-shell {
  width: 100%;
  min-height: 320rpx;
  border-radius: 24rpx;
  background: #fff8f2;
  border: 1rpx solid rgba(239, 217, 199, 0.8);
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 320rpx;
  background: #f8efe6;
}

.upload-placeholder {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  border: 2rpx dashed #efcfb2;
  background: #fffaf5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-plus {
  font-size: 70rpx;
  color: #d7b8a1;
  line-height: 1;
}

.upload-placeholder-text {
  font-size: 26rpx;
  color: #b99984;
}
