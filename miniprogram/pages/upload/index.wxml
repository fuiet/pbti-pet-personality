<view class="screen stack upload-page">
  <view class="card stack upload-intro">
    <view class="species-illustration-shell">
      <image class="species-illustration" src="{{testContext.species === 'dog' ? heroImages.dog : heroImages.cat}}" mode="aspectFit" />
    </view>
    <text class="title">上传三张识别照片</text>
    <text class="subtitle">上传正脸、左侧、右侧三张图后继续测评。后续接入云开发时，这里会先上传到云存储，再交给云函数处理。</text>
    <view class="progress-shell">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{uploadProgress}}%;"></view>
      </view>
      <text class="progress-text">{{uploadProgress}}% 已完成</text>
    </view>
  </view>

  <view class="card stack">
    <text class="section-title">宠物类型</text>
    <view class="species-row">
      <view class="species-chip {{testContext.species === 'cat' ? 'active' : ''}}" data-value="cat" bindtap="selectSpecies">猫</view>
      <view class="species-chip {{testContext.species === 'dog' ? 'active' : ''}}" data-value="dog" bindtap="selectSpecies">狗</view>
    </view>
  </view>

  <view class="stack">
    <view wx:for="{{photoSlots}}" wx:key="key" class="card stack upload-card">
      <view class="upload-card-head">
        <text class="section-title">{{item.label}}</text>
        <text class="photo-state {{item.path ? 'done' : ''}}">{{item.path ? '已完成' : '未完成'}}</text>
      </view>
      <view class="upload-preview-shell">
        <image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFit" class="upload-preview" data-path="{{item.path}}" bindtap="previewImage" />
        <view wx:else class="upload-placeholder" bindtap="pickImage" data-key="{{item.key}}">
          <text class="upload-plus">+</text>
          <text class="upload-placeholder-text">选择宠物照片</text>
        </view>
      </view>
      <view class="row">
        <button class="button-secondary" data-key="{{item.key}}" bindtap="pickImage">{{item.path ? '重新选择' : '选择照片'}}</button>
        <button wx:if="{{item.path}}" class="button-ghost" data-path="{{item.path}}" bindtap="previewImage">预览</button>
      </view>
    </view>
  </view>

  <view class="row">
    <button class="button-ghost" bindtap="resetPhotos">重置</button>
    <button class="button-primary" bindtap="nextStep">进入 28 题测评</button>
  </view>
</view>
