.portrait-page {
  background: #fbf7f1;
  padding-bottom: 170rpx;
}

.generating-card {
  border: 1rpx solid rgba(255, 122, 34, 0.18);
  background: #fff8f1;
}

.generated-card {
  border: 1rpx solid rgba(255, 122, 34, 0.18);
  background: #ffffff;
}

.generated-image {
  width: 100%;
  border-radius: 24rpx;
  background: #f7f2ec;
}

.portrait-preview-card {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(255, 196, 140, 0.45);
}

.portrait-preview-visual {
  padding: 4rpx 0 2rpx;
}

.portrait-preview-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1e5;
  color: #ff6a1a;
  font-size: 20rpx;
  font-weight: 700;
}

.portrait-preview-title {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.15;
}

.portrait-preview-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #6b7280;
}

.portrait-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mini-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #ead8c9;
  font-size: 22rpx;
  color: #8f735f;
}

.template-item {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f1ddd0;
}

.template-item.active {
  border-color: #ffb57a;
  background: #fff4e8;
}

.template-thumb {
  width: 124rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #f9f1e8;
  flex-shrink: 0;
}

.template-copy {
  flex: 1;
  min-width: 0;
}

.template-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.template-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 12rpx;
}

.template-current {
  margin-top: 12rpx;
  display: flex;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f1ddd0;
}

.template-current-thumb {
  width: 140rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #f9f1e8;
  flex-shrink: 0;
}

.photo-tip {
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.photo-panel {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f1ddd0;
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
}

.photo-mini {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 0 0 220rpx;
}

.photo-mini-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.photo-mini-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #111827;
}

.photo-mini-state {
  font-size: 18rpx;
  color: #b08f75;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #fff7f0;
  border: 1rpx solid #efd9c7;
}

.photo-mini-state.done {
  color: #ff6a1a;
  background: #fff1e5;
  border-color: #ffb57a;
}

.photo-mini-body {
  height: 112rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #efcfb2;
  background: #fffdf9;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-mini-image {
  width: 100%;
  height: 100%;
}

.photo-mini-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.photo-mini-plus {
  font-size: 36rpx;
  line-height: 1;
  color: #d7b8a1;
}

.photo-mini-empty-text {
  font-size: 20rpx;
  color: #b99984;
}

.upload-progress-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.upload-progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f2e4d8;
  overflow: hidden;
}

.upload-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff8a2a 0%, #ff6a1a 100%);
}

.upload-progress-text {
  font-size: 22rpx;
  color: #9a7b65;
}

.prompt-box {
  min-height: 170rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid #f0dccb;
  padding: 18rpx;
  box-sizing: border-box;
}

.prompt-input {
  width: 100%;
  min-height: 134rpx;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.6;
}

.button-primary {
  margin-top: 8rpx;
}

.prompt-actions {
  margin-top: 12rpx;
  justify-content: flex-end;
}
