<view class="screen stack">
  <view class="card stack">
    <text class="section-title">写真库</text>
    <text class="muted">这里保存已经生成完成的 AI 写真，点击图片可以预览大图。</text>

    <view wx:if="{{portraitAssets.length}}" class="portrait-grid">
      <view
        wx:for="{{portraitAssets}}"
        wx:key="_id"
        class="portrait-item"
        data-url="{{item.imageUrl}}"
        bindtap="previewPortrait"
      >
        <image class="portrait-item-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <text class="portrait-item-title">{{item.templateName || 'AI 写真'}}</text>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="muted">还没有生成作品，可以先去写真工作台创建第一张。</text>
    </view>

    <view class="row">
      <button class="button-secondary" bindtap="loadAssets">刷新写真库</button>
      <button class="button-primary" bindtap="openPortraitStudio">去生成新写真</button>
    </view>
  </view>
</view>
