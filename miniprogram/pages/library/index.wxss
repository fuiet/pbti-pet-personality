.portrait-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 10rpx;
}

.portrait-item {
  width: calc(50% - 9rpx);
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff8f0;
  border: 1rpx solid rgba(242, 204, 171, 0.4);
}

.portrait-item-image {
  width: 100%;
  height: 220rpx;
  display: block;
}

.portrait-item-title {
  display: block;
  padding: 12rpx 14rpx 14rpx;
  font-size: 24rpx;
  color: #4a3c31;
}

.empty-state {
  padding: 22rpx 0 8rpx;
}
