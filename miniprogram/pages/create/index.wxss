.create-page {
  padding-bottom: 170rpx;
}

.create-hero-image {
  width: 100%;
  height: 220rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
}

.species-row {
  display: flex;
  gap: 16rpx;
}

.species-card {
  flex: 1;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(239, 217, 199, 0.9);
  background: #fff8f2;
  text-align: center;
  box-sizing: border-box;
}

.species-card.active {
  border-color: #ffb57a;
  background: #fff1e5;
  box-shadow: 0 12rpx 28rpx rgba(255, 106, 26, 0.12);
}

.species-card-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f251d;
}

.compact-stack {
  gap: 20rpx;
}

.picker-field {
  min-height: 88rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.32);
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  color: #94a3b8;
  box-sizing: border-box;
}

.picker-field.has-value {
  color: #1f2937;
}

.gender-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.gender-chip {
  min-width: 150rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  text-align: center;
  color: #475569;
  box-sizing: border-box;
}

.gender-chip.active {
  border-color: #fb923c;
  background: #fff7ed;
  color: #c2410c;
  font-weight: 700;
}

.summary-card {
  background: linear-gradient(180deg, rgba(255, 247, 237, 0.95) 0%, rgba(255, 255, 255, 0.96) 100%);
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.summary-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(239, 217, 199, 0.85);
  box-sizing: border-box;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #9a7b65;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2f251d;
  line-height: 1.35;
}
