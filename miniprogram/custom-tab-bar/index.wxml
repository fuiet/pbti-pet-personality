<view class="tabbar-wrap">
  <view class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-dot" wx:if="{{selected === index}}"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
